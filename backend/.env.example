# ================================================================
# VoiceBot Backend — Environment Variables
# ================================================================
# Copy this file:  cp .env.example .env
# Then fill in every value before running the server.
# NEVER commit the real .env file — it is listed in .gitignore.
# ================================================================


# ── Bhashini (Speech Pipeline Orchestration) ─────────────────────
# Obtain all three values from https://bhashini.gov.in/ulca/user/my-profile
#
# ulcaApiKey — shown on the API Keys tab of your profile
BHASHINI_API_KEY=your_ulca_api_key_here
#
# userID — shown at the top of the My Profile page
BHASHINI_USER_ID=your_bhashini_user_id_here
#
# Pipeline ID — the ID of your configured ASR → TTS pipeline.
# Create one at: https://bhashini.gov.in/ulca/model-search
# Select a pipeline that includes both ASR (speech-to-text) and TTS (text-to-speech) tasks.
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here


# ── Groq (LLM Inference Engine) ──────────────────────────────────
# Generate your key at: https://console.groq.com/keys
# Model used: llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here


# ── Supabase (Database & Pooling) ────────────────────────────────
# All values found in: Supabase Dashboard → Project Settings → Database
#
# Direct Connection (IPv6) — used for migrations and local development.
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres
#
# Supavisor Connection Pooler (Transaction Mode, Port 6543).
# Required for Render deployments (IPv4 only — direct connection is IPv6).
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_POOLER_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Supabase REST API endpoint (used by the supabase-py client)
# Found in: Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
#
# Supabase anon/public key (used by the supabase-py client)
# Found in: Project Settings → API → Project API Keys → anon public
SUPABASE_KEY=your_supabase_anon_key_here


# ── CORS & Deployment ────────────────────────────────────────────
# The exact URL of your deployed Vercel frontend.
# No trailing slash. Include the full protocol (https://).
# Local dev example:    http://localhost:5173
# Production example:   https://your-project.vercel.app
FRONTEND_URL=https://your-project.vercel.app
#
# Port the FastAPI/Uvicorn server listens on.
# Render automatically injects its own PORT; this default is for local use.
PORT=8000
